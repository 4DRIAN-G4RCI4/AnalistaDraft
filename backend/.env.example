# Copia este archivo como .env y pon tu key gratis de https://the-odds-api.com (opcional).
# Sin key la app usa solo los momios de DraftKings que trae ESPN.
ODDS_API_KEY=
# us = DraftKings, FanDuel, BetMGM… | eu,uk = bet365, Pinnacle… (cada región extra cuesta más créditos)
ODDS_REGIONES=us
# Horas que se reutilizan las cuotas antes de gastar créditos otra vez (2 créditos por liga por consulta).
ODDS_TTL_HORAS=12

# Registro de aciertos (opcional): proyecto de Supabase con la tabla de docs/supabase.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
